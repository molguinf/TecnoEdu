@model TecnoEdu.Models.ViewModels.InstituteDirectoryViewModel
@{
    ViewData["Title"] = "Institutes";
    var hasFilters = Model.Search != "" || Model.City != "";
}

@section Hero {
    <section class="hero">
        <div class="container py-4 py-md-5">
            <span class="hero-badge"><span aria-hidden="true">✦</span> Directory</span>
            <h1 class="page-title">Technical <span class="text-brand">institutes</span></h1>
            <p class="hero-lead">Get to know TecnoEdu's institutes and contact them directly.</p>

            <form method="get" asp-controller="Institutes" asp-action="Index" role="search"
                  aria-label="Search institutes" class="search-box">
                <label for="search" class="visually-hidden">Institute name</label>
                <input id="search" name="search" type="search" class="form-control search-input"
                       value="@Model.Search" placeholder="Search by name" />
                <label for="city" class="visually-hidden">City</label>
                <select id="city" name="city" class="form-select search-select">
                    <option value="">All cities</option>
                    @foreach (var city in Model.Cities)
                    {
                        <option value="@city" selected="@(string.Equals(city, Model.City, StringComparison.OrdinalIgnoreCase))">@city</option>
                    }
                </select>
                <button type="submit" class="btn btn-brand search-button">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                    Search
                </button>
            </form>
            @if (hasFilters)
            {
                <p class="hero-hint"><a asp-controller="Institutes" asp-action="Index">Clear filters</a></p>
            }
        </div>
    </section>
}

<section class="pt-5" aria-label="Results">
    @if (Model.Institutes.Count == 0 && hasFilters)
    {
        <div class="empty-state">
            <p class="mb-0">No institutes match your search.</p>
        </div>
    }
    else
    {
        <partial name="_InstituteCards" model="Model.Institutes" />
    }
</section>
