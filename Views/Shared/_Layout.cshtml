<!DOCTYPE html>
@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TecnoEdu</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TecnoEdu.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="site-header">
        <nav class="navbar navbar-expand-md" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true"></span><span>Tecno<span class="text-brand">Edu</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Open menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto gap-md-2">
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Home" ? "active" : null)"
                               aria-current="@(controller == "Home" ? "page" : null)"
                               asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Courses" || controller == "Categories" ? "active" : null)"
                               aria-current="@(controller == "Courses" ? "page" : null)"
                               asp-area="" asp-controller="Courses" asp-action="Index">Explore</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Institutes" ? "active" : null)"
                               aria-current="@(controller == "Institutes" ? "page" : null)"
                               asp-area="" asp-controller="Institutes" asp-action="Index">Institutes</a>
                        </li>
                    </ul>
                    @* TODO: link to the login page once the authentication module is ready. *@
                    <a class="btn btn-brand" href="#">Log in</a>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 pb-5">
        @await RenderSectionAsync("Hero", required: false)
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container py-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <h2 class="h5 fw-bold mb-1">Do you represent an institute?</h2>
                <p class="mb-0">Connect with your <span class="text-brand-light">future students</span>.</p>
            </div>
            @* TODO: link to institute sign-up once it exists. *@
            <a class="btn btn-brand btn-lg" href="#">Join TecnoEdu</a>
        </div>
        <div class="footer-bottom">
            <div class="container small py-3">
                &copy; 2026 TecnoEdu · <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
