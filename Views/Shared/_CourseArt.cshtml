@model int
@* Decorative card illustration; the variant is CategoryId % 3. *@
@switch (Model)
{
    case 0:
        <svg viewBox="0 0 120 80" aria-hidden="true" focusable="false">
            <rect x="28" y="12" width="64" height="42" rx="4" fill="#fff" stroke="#4338ca" stroke-width="4" />
            <path d="M16 60h88l-6 7H22z" fill="#4338ca" />
            <path d="M52 26l-8 7 8 7M68 26l8 7-8 7M62 23l-4 20" fill="none" stroke="#4338ca" stroke-width="3.5"
                  stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        break;
    case 1:
        <svg viewBox="0 0 120 80" aria-hidden="true" focusable="false">
            <circle cx="46" cy="42" r="18" fill="#5eead4" />
            <rect x="58" y="32" width="30" height="30" rx="5" fill="#2dd4bf" opacity=".85" />
            <path d="M60 12 84 62H36z" fill="none" stroke="#0f766e" stroke-width="4" stroke-linejoin="round" />
        </svg>
        break;
    default:
        <svg viewBox="0 0 120 80" aria-hidden="true" focusable="false">
            <rect x="34" y="44" width="12" height="22" rx="2" fill="#e0a96d" />
            <rect x="54" y="30" width="12" height="36" rx="2" fill="#d97706" />
            <rect x="74" y="14" width="12" height="52" rx="2" fill="#b45309" />
        </svg>
        break;
}
